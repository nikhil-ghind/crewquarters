#!/bin/sh
# Before an upgrade replaces files: back up the database if the stack is running.
set -e
if [ "$1" = "upgrade" ] && command -v docker >/dev/null 2>&1; then
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx crewquarters-postgres-1; then
        install -d -m 0700 /var/lib/crewquarters/backups
        stamp=$(date -u +%Y%m%dT%H%M%SZ)
        target="/var/lib/crewquarters/backups/pre-upgrade-$2-$stamp.sql.gz"
        # No pipefail in /bin/sh: dump to a file first, then compress, checking each step.
        tmp="${target%.gz}"
        if docker exec crewquarters-postgres-1 pg_dump -U crewquarters crewquarters > "$tmp" \
            && [ -s "$tmp" ] && gzip -f "$tmp"; then
            echo "crewquarters: database backed up to $target"
        else
            rm -f "$tmp" "$target"
            echo "crewquarters: WARNING database backup failed; upgrade continues" >&2
        fi
    fi
fi
exit 0
