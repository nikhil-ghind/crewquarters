#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|upgrade|deconfigure)
            systemctl stop crewquarters.service >/dev/null 2>&1 || true
            systemctl stop crewquarters-runtime.service crewquarters-runtime.socket >/dev/null 2>&1 || true
            ;;
    esac
    if [ "$1" = "remove" ]; then
        # Containers started by the runtime daemon (agents, model servers) are not part
        # of the Compose stack; stop them so nothing keeps holding memory or GPU.
        if command -v docker >/dev/null 2>&1; then
            for kind in run model; do
                docker ps -aq --filter "label=io.crewquarters.kind=$kind" 2>/dev/null \
                    | xargs -r docker rm -f >/dev/null 2>&1 || true
            done
        fi
        systemctl disable crewquarters.service crewquarters-runtime.socket crewquarters-netguard.service >/dev/null 2>&1 || true
        systemctl stop crewquarters-netguard.service >/dev/null 2>&1 || true
    fi
fi
exit 0
