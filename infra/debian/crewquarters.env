# Crewquarters appliance settings (conffile; kept on upgrade). Secrets live in
# /etc/crewquarters/secrets.env, generated by the installer.
CQ_VERSION=@VERSION@
CQ_PLATFORM_IMAGE=crewquarters/platform
# Listen on localhost only. LAN mode needs HTTPS (PLAN.md section 10.1).
CQ_BIND_ADDRESS=127.0.0.1
CQ_PUBLIC_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
CQ_COOKIE_SECURE=false
# Memory admission policy (bytes): 24 GiB system reserve, 96 GiB serving cap, 8 GiB margin.
CQ_GATEWAY_SYSTEM_RESERVE_BYTES=25769803776
CQ_GATEWAY_MAX_SERVING_BYTES=103079215104
CQ_GATEWAY_LOAD_SAFETY_MARGIN_BYTES=8589934592
CQ_GATEWAY_IDLE_UNLOAD_SECONDS=600
