# Crewquarters appliance settings (conffile; kept on upgrade). Secrets live in
# /etc/crewquarters/secrets.env, generated by the installer.
CQ_VERSION=@VERSION@
CQ_PLATFORM_IMAGE=crewquarters/platform
CQ_PROXY_IMAGE=crewquarters/proxy
# The proxy is the only published port. Listen on localhost only; LAN mode needs HTTPS
# (PLAN.md section 10.1).
CQ_BIND_ADDRESS=127.0.0.1
CQ_HTTP_PORT=8080
# Public origin for the Google OAuth redirect and Twilio callbacks. For a callback tunnel
# (crewquarters tunnel up) set it to the tunnel's https:// hostname.
CQ_PUBLIC_BASE_URL=http://localhost:8080
# Capability broker providers: live (Google/Twilio) or fake. Google/Twilio credentials
# (CQ_GOOGLE_CLIENT_ID, CQ_GOOGLE_CLIENT_SECRET) and CQ_TUNNEL_TOKEN go in secrets.env.
CQ_PROVIDER_MODE=live
# Knowledge embeddings: local (pinned CPU model, fetched once) or fake.
CQ_EMBEDDING_MODE=local
CQ_PUBLIC_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
CQ_COOKIE_SECURE=false
# Memory admission policy (bytes): 24 GiB system reserve, 96 GiB serving cap, 8 GiB margin.
CQ_GATEWAY_SYSTEM_RESERVE_BYTES=25769803776
CQ_GATEWAY_MAX_SERVING_BYTES=103079215104
CQ_GATEWAY_LOAD_SAFETY_MARGIN_BYTES=8589934592
CQ_GATEWAY_IDLE_UNLOAD_SECONDS=600
