# Real-stack E2E (compose.realstack.yaml, project `cqreal`): its own ports, images and data
# directory, so it never collides with a developer's stack (8080/55432) or `make fake-up`.
CQ_HTTP_PORT=18083
CQ_POSTGRES_PORT=15435
CQ_PUBLIC_BASE_URL=http://localhost:18083
CQ_PLATFORM_IMAGE=crewquarters/platform:cqreal
CQ_PROXY_IMAGE=crewquarters/proxy:cqreal
CQ_DATA_DIR=/tmp/cqreal-data
CQ_REALSTACK_REGISTRY_PORT=15001
CQ_REALSTACK_BROKER_ADMIN_PORT=18084
CQ_REALSTACK_ADMIN_TOKEN=realstack-admin-token-0000000000
