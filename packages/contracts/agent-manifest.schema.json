{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crewquarters.local/contracts/agent-manifest/v1alpha1",
  "title": "Crewquarters agent manifest",
  "description": "Versioned agent manifest (apiVersion crewquarters/v1alpha1). Canonical contract; changes require review by every affected owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "crewquarters/v1alpha1"},
    "kind": {"const": "Agent"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
        },
        "summary": {"type": "string", "maxLength": 280},
        "description": {"type": "string", "maxLength": 8000},
        "publisher": {"type": "string", "maxLength": 80}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "entrypoint", "architectures", "triggers", "permissions", "resources"],
      "properties": {
        "image": {
          "description": "OCI image pinned by digest. Mutable tag-only references are rejected.",
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+(:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$"
        },
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "sdkProtocol": {"type": "string", "enum": ["v1alpha1"], "default": "v1alpha1"},
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["linux/amd64", "linux/arm64"]}
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["manual", "schedule"]}
        },
        "permissions": {"$ref": "#/$defs/permissions"},
        "resources": {"$ref": "#/$defs/resources"},
        "configurationSchema": {
          "description": "JSON Schema (draft 2020-12) for installation configuration.",
          "type": "object"
        },
        "resultSchema": {
          "description": "Optional JSON Schema describing the run result; selects the UI renderer.",
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llmProfiles", "knowledge", "connectors", "cloudProviders", "userInput"],
      "properties": {
        "llmProfiles": {
          "description": "Model profile families (local.general) or exact variants (local.general.small).",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(local|openai|anthropic)\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$"
          }
        },
        "knowledge": {
          "description": "Knowledge access. 'config' means the knowledge base selected in installation config.",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["config"]}
        },
        "connectors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "google": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["gmail.readonly", "gmail.send", "spreadsheets"]}
            },
            "twilio": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "enum": ["call.fixed_script"]}
            }
          }
        },
        "camera": {
          "description": "Camera snapshots. 'config' means the snapshot URL set in installation config (cameraUrl).",
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["config"]}
        },
        "cloudProviders": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["openai", "anthropic"]}
        },
        "userInput": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memoryMb", "activeTimeoutSeconds"],
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0, "maximum": 8},
        "memoryMb": {"type": "integer", "minimum": 64, "maximum": 16384},
        "pids": {"type": "integer", "minimum": 16, "maximum": 4096, "default": 256},
        "activeTimeoutSeconds": {"type": "integer", "minimum": 10, "maximum": 86400},
        "maxInputWaitSeconds": {"type": "integer", "minimum": 0, "maximum": 86400, "default": 86400}
      }
    }
  }
}
